{
  "name": "nexus-pro-app",
  "private": true,
  "version": "1.0.0",
  "author": "Charis",
  "description": "Odyseus Nexus Pro - AI-powered software builder OS",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit",
    "electron:dev": "start \"\" tsx server/index.ts & electron .",
    "build:server": "tsc -p server/tsconfig.json",
    "copy:dist": "node scripts/copy-dist.cjs",
    "prepack": "npm run copy:dist",
    "electron:build": "vite build && npm run build:server && npm run copy:dist && electron-builder build",
    "electron:build:win": "vite build && npm run build:server && npm run copy:dist && electron-builder build --win",
    "electron:build:mac": "vite build && npm run build:server && npm run copy:dist && electron-builder build --mac",
    "electron:build:linux": "vite build && npm run build:server && npm run copy:dist && electron-builder build --linux"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.odyseus.nexuspro",
    "productName": "Odyseus Nexus Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/assets/**/*",
      "electron/dist/**/*",
      "electron/server-dist/**/*",
      "electron/main.cjs",
      "electron/preload.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": "electron/dist/**/*,electron/server-dist/**/*",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Charis Chara <characharis01@gmail.com>",
      "synopsis": "Odyseus Nexus Pro — AI-powered software builder OS",
      "syncDesktopName": true
    },
    "desktopName": "Odyseus Nexus Pro",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "electron-store": "^8.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.11.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
