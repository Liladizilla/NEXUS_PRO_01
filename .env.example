# Example environment file for Odyseus
# Copy this to .env and fill in your real credentials.
# IMPORTANT: .env is gitignored and MUST NEVER be committed.

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# LLM / API keys (server-side, kept secret)
GEMINI_API_KEY=
API_KEY=

# GitHub OAuth (server-side, kept secret)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Firebase web config (client-side, exposed to the browser by design).
# These are NOT secrets, but we load them from env so the real values
# stay out of source control. Set them in your .env (local) and in your
# hosting provider's environment variables for production (e.g. Vercel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
