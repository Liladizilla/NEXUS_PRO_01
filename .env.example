# ============================================================================
# Odyseus Nexus Pro - Environment Configuration
# ============================================================================
# Provider keys are server-only. Do not prefix AI provider keys with VITE_.
# The server accepts legacy spellings because existing hosting variables may
# not be editable in-place. Preferred names are GROQ_API_KEY and OPENROUTER_API_KEY.
#
# Accepted Groq aliases: GROQ_API_KEY, GROQ_APIKEY, GROQ_KEY, GROQ_API_TOKEN,
# GROK_API_KEY, GROK_APIKEY, GROK_KEY, GROK_API_TOKEN
# Accepted OpenRouter aliases: OPENROUTER_API_KEY, OPEN_ROUTER_API_KEY,
# OPENROUTER_KEY, OPEN_ROUTER_KEY, OPENROUTER_APIKEY, OPEN_ROUTER_APIKEY
# Optional model overrides: GROQ_MODEL / GROK_MODEL, OPENROUTER_MODEL / OPEN_ROUTER_MODEL
# Optional Gemini fallback: GEMINI_API_KEY, GOOGLE_GEMINI_API_KEY, API_KEY

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# AI provider keys (keep blank in this template; set real values in host settings)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Firebase public web configuration (required for authentication and Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: omit to use the default Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Optional GitHub OAuth server credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
