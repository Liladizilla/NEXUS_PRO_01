# ============================================================================
# Odyseus Nexus Pro — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values. `.env` is GITIGNORED and
# MUST NEVER be committed. Then ALSO set every VITE_* and GEMINI_API_KEY var in
# your hosting provider's dashboard (e.g. Vercel) — they are not in the repo.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- REQUIRED: Gemini (client-side AI generation) ----
# Baked into the client bundle at build time. Use a KEY RESTRICTED to your
# domain in Google AI Studio / GCP, since it is publicly visible in the browser.
GEMINI_API_KEY=

# ---- REQUIRED: Firebase web config (client-side) ----
# Public by design (shipped to the browser) but loaded from env so the real
# values stay out of source control. Set these in Vercel too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# ---- OPTIONAL: GitHub OAuth (server-side token exchange only) ----
# The in-app "Sign in with GitHub" uses Firebase's GitHub provider (popup) and
# does NOT need these. Only set them if you wire the server OAuth flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- NOT YET USED BY THE APP (kept for future use) ----
# These are PRESENT in the local .env but the current codebase does not read
# them. Treat ALL of the following as SERVER-ONLY SECRETS:
#   - never prefix them with VITE_ (that would expose them to the browser)
#   - never commit them
#   - the SERVICE_ROLE / SECRET / JWT / PASSWORD values bypass all security
#     rules and must stay strictly server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
