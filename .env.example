# ============================================================================
# Odyseus Nexus Pro — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values. `.env` is GITIGNORED and
# MUST NEVER be committed. Set the VITE_* values as build-time environment variables
# and GEMINI_API_KEY as a server-only environment variable in your host.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- REQUIRED: Gemini (server-side AI generation) ----
# Keep this server-only. Never prefix it with VITE_ or expose it in browser code.
GEMINI_API_KEY=

# ---- REQUIRED: Firebase Authentication + Firestore ----
# Enable Email/Password, Google, and (if desired) GitHub in Firebase Console → Authentication → Sign-in method.
# Add the deployed Vercel domain under Authentication → Settings → Authorized domains.
# Firebase web config values are public client configuration, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: omit to use the default Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# ---- OPTIONAL: GitHub OAuth (server-side token exchange only) ----
# The in-app GitHub sign-in uses Firebase Authentication's GitHub provider.
# Configure the GitHub OAuth app credentials in Firebase Console if enabling it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- NOT YET USED BY THE APP (kept for future use) ----
# These are PRESENT in the local .env but the current codebase does not read
# them. Treat ALL of the following as SERVER-ONLY SECRETS:
#   - never prefix them with VITE_ (that would expose them to the browser)
#   - never commit them
#   - the SERVICE_ROLE / SECRET / JWT / PASSWORD values bypass all security
#     rules and must stay strictly server-side.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
