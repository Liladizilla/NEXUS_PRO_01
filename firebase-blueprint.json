{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user profile information like display name and avatar URL.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user (Firebase Auth UID)."
        },
        "displayName": {
          "type": "string",
          "description": "The user's chosen display name."
        },
        "photoURL": {
          "type": "string",
          "format": "url",
          "description": "The URL to the user's avatar image."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address (private)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of the last profile update."
        }
      },
      "required": ["uid", "displayName", "email"]
    },
    "api_keys": {
      "title": "API Key",
      "description": "Stores a user's generated API key and its metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user (Firebase Auth UID)."
        },
        "key": {
          "type": "string",
          "description": "The generated API key."
        },
        "lastGeneratedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of the last key generation."
        }
      },
      "required": ["uid", "key", "lastGeneratedAt"]
    },
    "projects": {
      "title": "Project",
      "description": "Stores project metadata and configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "framework": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name"]
    },
    "files": {
      "title": "Project File",
      "description": "Stores individual file content within a project.",
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "content": { "type": "string" },
        "language": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["path", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "A collection of user profile documents, keyed by their Auth UID."
    },
    "/api_keys/{userId}": {
      "schema": "api_keys",
      "description": "A collection of API keys, keyed by the user's Auth UID."
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "A collection of projects."
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "files",
      "description": "A subcollection of files for a specific project."
    }
  }
}
