{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/staging/:taskId(.*)",
      "destination": "/api/staging/:taskId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
